# Bumparr configuration. Copy to `.env`; every setting has a working default,
# so you only need to set what you want to change. Variables are plain,
# function-named — no prefix.

# --- Server ------------------------------------------------------------------
# PORT=8780
# PUBLIC_URL=https://bumpers.example.com   # set behind a reverse proxy so emitted
#   M3U / bumper URLs are absolute for ErsatzTV / Tunarr / Dispatcharr.
# TZ=America/New_York                      # for the clock / local-time card.

# --- Storage -----------------------------------------------------------------
# Where the bumper library and SQLite DB live. Default: ./assets and ./data.
# ASSETS=/path/to/your/bumper-library
# DATA=/path/to/your/data

# --- Branding & fonts --------------------------------------------------------
# BRAND=Bumparr
# Bundled OFL fonts: card-nunito.ttf, card-quicksand.ttf. Drop your own .ttf/.otf
# on the font path and name it here (a personal-use font is YOUR config, never
# bundled — see bumparr/fonts/README.md).
# CARD_FONT=card-nunito.ttf
# BRAND_FONT=your-brand-font.ttf
# FONTS=/path/to/extra/fonts

# --- Content mix -------------------------------------------------------------
# How much of the rotation each bumper type gets (shares, roughly summed).
# Live "window" cams are a stream; raise SHARE_STREAM to make them a bigger
# presence, lower it to make them rare.
# SHARE_STREAM=0.28
# SHARE_VIDEO=0.40
# SHARE_CARD=0.25
# SHARE_IMAGE=0.07
# WINDOW_REFRESH_HOURS=2   # how often live-window cams re-snapshot.
# CARD_DUR=14              # seconds a text card stays on screen.

# --- Local model (OPTIONAL) --------------------------------------------------
# Bumparr ships NO model. Grounded cards (trivia, fun-facts, numbers), the
# procedural kinds, and a built-in starter set for every other kind all work
# with no model. Point this at any OpenAI-compatible endpoint to generate more.
# LLM_BASE=http://your-model-host:8080/v1
# LLM_MODEL=your-model-id
# LLM_DISABLE_THINKING=1   # set for reasoning models (Qwen etc.), or they spend
#   the whole token budget "thinking" and return empty content.

# --- Stock footage sources (for the shipped starter seeds) -------------------
# Free, self-signup keys. Needed only to run `starter` (the suggested search
# seeds); the ask-bar and archive.org sources work without them.
# PEXELS_API_KEY=your-pexels-key
# PIXABAY_API_KEY=your-pixabay-key
